{
  "name": "asterion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Asterion — an immersive digital museum for the history of Western esoteric traditions",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "textures:fetch": "node scripts/fetch-textures.mjs",
    "textures:scan": "node scripts/scan-textures.mjs",
    "textures:ktx2": "node scripts/optimize-textures-ktx2.mjs",
    "assets:optimize": "node scripts/optimize-models.mjs && node scripts/optimize-textures.mjs && node scripts/optimize-meshes.mjs && node scripts/optimize-models-lean.mjs",
    "assets:optimize:dry": "node scripts/optimize-models.mjs --dry && node scripts/optimize-textures.mjs --dry && node scripts/optimize-meshes.mjs --dry && node scripts/optimize-models-lean.mjs --dry",
    "models:lean": "node scripts/optimize-models-lean.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "fuse.js": "^7.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "meshoptimizer": "^1.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^3.2.7"
  }
}
